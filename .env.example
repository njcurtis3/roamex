# Copy to .env and fill in. .env is gitignored.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Model per stage. Defaults are in src/llm/openrouter.py — these override them.
#
# The tiering rationale: extract is high-volume and mechanical (read one block,
# fill a fixed schema), so it runs cheap. Resolve is low-volume and judgment-
# shaped — an over-merge silently corrupts every fact on both entities — so it
# does not. Query has to reason over a subgraph and cite it honestly.
#
# Any OpenRouter model id works; these are starting points, not requirements.
# ROAMEX_MODEL_EXTRACT=anthropic/claude-haiku-4.5
# ROAMEX_MODEL_RESOLVE=anthropic/claude-sonnet-4.5
# ROAMEX_MODEL_QUERY=anthropic/claude-sonnet-4.5
